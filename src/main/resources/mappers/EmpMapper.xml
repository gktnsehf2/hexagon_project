<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hexagon.hrms.mapper.EmpMapper">

	<!-- 사원 1 : 조직 1 / 직급 1 / 직책 0..1 → association 으로 부모 객체를 채움 -->
	<resultMap type="Emp" id="joinMap">
		<id		column="emp_id"			property="empId"/>
		<result	column="emp_no"			property="empNo"/>
		<result	column="ename"			property="ename"/>
		<result	column="gender"			property="gender"/>
		<result	column="email"			property="email"/>
		<result	column="phone"			property="phone"/>
		<result	column="hiredate"		property="hiredate"/>
		<result	column="photo_path"		property="photoPath"/>
		<result	column="resign_date"	property="resignDate"/>
		<result	column="status"			property="status"/>

		<association column="department_id" property="department" javaType="Department"
			select="com.hexagon.hrms.mapper.DepartmentMapper.select"/>
		<association column="job_id" property="job" javaType="Job"
			select="com.hexagon.hrms.mapper.JobMapper.select"/>
		<association column="hr_position_id" property="hrPosition" javaType="HrPosition"
			select="com.hexagon.hrms.mapper.HrPositionMapper.select"/>
	</resultMap>

	<sql id="columns">
		e.emp_id, e.emp_no, e.ename, e.gender, e.email, e.phone, e.hiredate, e.photo_path, e.resign_date,
		e.department_id, e.job_id, e.hr_position_id, e.status
	</sql>

	<select id="select" parameterType="int" resultMap="joinMap">
		select <include refid="columns"/>
		from emp e
		where e.emp_id = #{empId}
	</select>

	<!-- 검색 조건: 조회 범위(deptIds) + 이름/사번 + 직급 + 재직상태 -->
	<sql id="searchWhere">
		<where>
			<if test="deptIds != null">
				e.department_id in
				<foreach collection="deptIds" item="deptId" open="(" separator="," close=")">#{deptId}</foreach>
			</if>
			<if test="search.keyword != null and search.keyword != ''">
				and (e.ename like concat('%', #{search.keyword}, '%') or e.emp_no like concat('%', #{search.keyword}, '%'))
			</if>
			<if test="search.jobId != null and search.jobId > 0">
				and e.job_id = #{search.jobId}
			</if>
			<if test="search.status != null and search.status != ''">
				and e.status = #{search.status}
			</if>
		</where>
	</sql>

	<!-- 조직 순서 → 직급 높은 순 → 사번 순, 페이지 단위로 가져오기 -->
	<select id="selectList" resultMap="joinMap">
		select <include refid="columns"/>
		from emp e
		join job j on j.job_id = e.job_id
		<include refid="searchWhere"/>
		order by e.department_id, j.job_level desc, e.emp_id
		limit #{pager.pageSize} offset #{pager.offset}
	</select>

	<select id="selectCount" resultType="int">
		select count(*)
		from emp e
		<include refid="searchWhere"/>
	</select>

	<select id="selectNextSeq" resultType="int">
		select coalesce(max(emp_id), 0) + 1
		from emp
	</select>

	<select id="countByEmail" resultType="int">
		select count(*)
		from emp
		where email = #{email}
		  and emp_id != #{exceptEmpId}
	</select>

	<!-- 직책은 등록 때 없음(null). 조직장 임명은 인사 발령에서 -->
	<insert id="insert" parameterType="Emp" useGeneratedKeys="true" keyProperty="empId">
		insert into emp(emp_no, ename, gender, email, phone, hiredate, department_id, job_id, status)
		values(#{empNo}, #{ename}, #{gender}, #{email}, #{phone}, #{hiredate}, #{department.departmentId}, #{job.jobId}, 'ACTIVE')
	</insert>

	<update id="update" parameterType="Emp">
		update emp
		set ename = #{ename}, gender = #{gender}, email = #{email}, phone = #{phone}
		where emp_id = #{empId}
	</update>

	<update id="updatePhoto">
		update emp
		set photo_path = #{photoPath}
		where emp_id = #{empId}
	</update>

	<update id="updateResign" parameterType="Emp">
		update emp
		set status = #{status}, resign_date = #{resignDate}
		where emp_id = #{empId}
	</update>
</mapper>
